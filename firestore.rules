rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 平台資料：key 必須以 logistics: 開頭
    match /kv/{key} {
      allow read: if key.matches('logistics:.*');
      allow write: if key.matches('logistics:.*')
        && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string;
    }
  }
}
